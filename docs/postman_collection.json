{
  "info": {
    "name": "UnifyMFG Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Raw Materials",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/raw_materials",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "raw_materials"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5005"
    }
  ]
}